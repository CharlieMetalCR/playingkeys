generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Unit {
  id          String   @id @default(uuid())
  number      Int      @unique
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]

  @@map("units")
}

model Lesson {
  id          String   @id @default(uuid())
  unitId      String
  number      Int
  title       String
  content     Json     // Lesson content including notation, instructions, audio cues
  difficulty  Int      @default(1) // 1-5 scale
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  unit        Unit     @relation(fields: [unitId], references: [id])
  progress    Progress[]

  @@unique([unitId, number])
  @@map("lessons")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student?
  teacher   Teacher?
  admin     Admin?

  @@map("users")
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

model Student {
  id            String    @id @default(uuid())
  userId        String    @unique
  teacherId     String?
  phone         String?
  dateOfBirth   DateTime?
  emergencyContact String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id])
  teacher       Teacher?  @relation(fields: [teacherId], references: [id])
  progress      Progress[]
  payments      Payment[]

  @@map("students")
}

model Teacher {
  id        String    @id @default(uuid())
  userId    String    @unique
  phone     String?
  bio       String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
  students  Student[]
  notes     Note[]

  @@map("teachers")
}

model Admin {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@map("admins")
}

model Progress {
  id          String   @id @default(uuid())
  studentId   String
  lessonId    String
  status      ProgressStatus @default(NOT_STARTED)
  score       Int?     // 0-100
  completedAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     Student  @relation(fields: [studentId], references: [id])
  lesson      Lesson   @relation(fields: [lessonId], references: [id])

  @@unique([studentId, lessonId])
  @@map("progress")
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NEEDS_REVIEW
}

model Payment {
  id        String   @id @default(uuid())
  studentId String
  amount    Decimal
  currency  String   @default("USD")
  status    PaymentStatus
  dueDate   DateTime
  paidAt    DateTime?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student  @relation(fields: [studentId], references: [id])

  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model Note {
  id        String   @id @default(uuid())
  teacherId String
  studentId String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teacher   Teacher  @relation(fields: [teacherId], references: [id])

  @@map("notes")
}